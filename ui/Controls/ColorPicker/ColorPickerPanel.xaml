<UserControl x:Class="PhotoLab.UI.Controls.ColorPicker.ColorPickerPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="8">
    <ColorPicker x:Name="Picker" Color="#FF6FC8FF" IsAlphaEnabled="True" IsAlphaSliderVisible="True" IsAlphaTextInputVisible="True" IsHexInputVisible="True" IsColorChannelTextInputVisible="True" IsColorSliderVisible="True" IsColorPreviewVisible="True" ColorSpectrumShape="Box" ColorChanged="OnColorChanged" HorizontalAlignment="Stretch" />
    <TextBlock x:Name="ColorValues" TextWrapping="Wrap" FontSize="12" Foreground="#B8BBC4" />
    <TextBlock Text="Windows HEX: #AARRGGBB · RGBA: 0–255" FontSize="11" Foreground="#9296A3" />
  </StackPanel>
</UserControl>
