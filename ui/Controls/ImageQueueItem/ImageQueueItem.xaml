<UserControl x:Class="PhotoLab.UI.Controls.ImageQueueItem.ImageQueueItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="0,4" ColumnSpacing="10" Width="174">
    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="52" Height="52" CornerRadius="5" Background="#34363D"><Image Source="{Binding Thumbnail}" Stretch="Uniform" /></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
      <TextBlock Text="{Binding FileName}" ToolTipService.ToolTip="{Binding FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="11"/>
      <TextBlock Text="{Binding Dimensions}" FontSize="11" Foreground="#AAAEB9" />
    </StackPanel>
  </Grid>
</UserControl>
