<UserControl x:Class="PhotoLab.UI.Views.ProcessingPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="12">
    <TextBlock x:Name="ToolTitle" Text="Grayscale" FontSize="24" FontWeight="SemiBold"/>
    <TextBlock x:Name="ToolDescription" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10,8">
      <TextBlock x:Name="TargetHint" Text="Import an image to use this tool." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
    </Border>
    <StackPanel x:Name="PluginFields" Spacing="10" Visibility="Collapsed"/>
    <StackPanel x:Name="PluginMasksPanel" Spacing="8" Visibility="Collapsed">
      <TextBlock Text="Masks for this transformation" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="Check the masks to send. None selected = no mask. Manage them in Masks." TextWrapping="Wrap" FontSize="11"/>
      <StackPanel x:Name="PluginMaskChoices" Spacing="4"/>
    </StackPanel>
    <Expander x:Name="ParametersPanel" Header="Parameters" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="12">
        <StackPanel x:Name="TransformPanel" Visibility="Collapsed" Spacing="12">
          <StackPanel x:Name="AngleControls" Spacing="8">
            <NumberBox x:Name="AngleInput" Header="Angle (degrees, clockwise)" Value="0" Minimum="-360" Maximum="360" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="TransformValueChanged" AutomationProperties.AutomationId="TransformAngle"/>
            <Grid ColumnSpacing="4" RowSpacing="4">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <Button Content="−90°" Tag="-90" Click="AnglePresetClicked" HorizontalAlignment="Stretch" Padding="4,7" AutomationProperties.AutomationId="AngleMinus90"/>
              <Button Grid.Column="1" Content="−45°" Tag="-45" Click="AnglePresetClicked" HorizontalAlignment="Stretch" Padding="4,7"/>
              <Button Grid.Column="2" Content="0°" Tag="0" Click="AnglePresetClicked" HorizontalAlignment="Stretch" Padding="4,7"/>
              <Button Grid.Row="1" Content="45°" Tag="45" Click="AnglePresetClicked" HorizontalAlignment="Stretch" Padding="4,7" AutomationProperties.AutomationId="Angle45"/>
              <Button Grid.Row="1" Grid.Column="1" Content="90°" Tag="90" Click="AnglePresetClicked" HorizontalAlignment="Stretch" Padding="4,7" AutomationProperties.AutomationId="Angle90"/>
              <Button Grid.Row="1" Grid.Column="2" Content="180°" Tag="180" Click="AnglePresetClicked" HorizontalAlignment="Stretch" Padding="4,7"/>
            </Grid>
          </StackPanel>
          <StackPanel x:Name="ScaleControls" Spacing="8">
            <NumberBox x:Name="ScaleInput" Header="Scale (%)" Value="100" Minimum="1" Maximum="800" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="TransformValueChanged" AutomationProperties.AutomationId="TransformScale"/>
            <Grid ColumnSpacing="3">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button Content="25%" Tag="25" Click="ScalePresetClicked" HorizontalAlignment="Stretch" Padding="3,7"/>
              <Button Grid.Column="1" Content="50%" Tag="50" Click="ScalePresetClicked" HorizontalAlignment="Stretch" Padding="3,7" AutomationProperties.AutomationId="Scale50"/>
              <Button Grid.Column="2" Content="100%" Tag="100" Click="ScalePresetClicked" HorizontalAlignment="Stretch" Padding="3,7"/>
              <Button Grid.Column="3" Content="200%" Tag="200" Click="ScalePresetClicked" HorizontalAlignment="Stretch" Padding="3,7"/>
            </Grid>
          </StackPanel>
          <TextBlock x:Name="TransformGestureHint" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock x:Name="TransformSizeText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Reset" Click="ResetTransformClicked" AutomationProperties.AutomationId="ResetTransform"/>
            <Button Content="Fit preview" Click="FitTransformClicked" AutomationProperties.AutomationId="FitTransform"/>
          </StackPanel>
          <TextBlock Text="Preview only. Apply creates a new image version." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <ComboBox x:Name="NestedOperation" Header="Filter to apply to the selection" SelectedIndex="0" SelectionChanged="NestedOperationChanged" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Grayscale" Tag="to_grayscale"/><ComboBoxItem Content="Blur" Tag="apply_blur"/>
          <ComboBoxItem Content="Border" Tag="apply_border"/><ComboBoxItem Content="Edges" Tag="apply_contours"/>
          <ComboBoxItem Content="Channel separation" Tag="apply_color_separation"/>
        </ComboBox>
        <ComboBox x:Name="BlurTypePicker" Header="Blur type" SelectedIndex="0" SelectionChanged="FilterVariantChanged" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="BlurType">
          <ComboBoxItem Content="Gaussian blur" Tag="gaussian"/>
          <ComboBoxItem Content="Average blur (Box)" Tag="average"/>
          <ComboBoxItem Content="Median blur" Tag="median"/>
          <ComboBoxItem Content="Bilateral filter" Tag="bilateral"/>
        </ComboBox>
        <TextBlock x:Name="BlurTypeHint" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
        <NumberBox x:Name="BlurRadius" Header="Sigma (px)" Value="5" Minimum="0.1" Maximum="1000" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="BlurSigma"/>
        <NumberBox x:Name="BlurKernelSize" Header="Kernel size (px)" Value="5" Minimum="1" Maximum="255" SmallChange="2" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="BlurKernelSize"/>
        <NumberBox x:Name="BilateralDiameter" Header="Neighborhood diameter (px)" Value="9" Minimum="1" Maximum="255" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="BilateralDiameter"/>
        <NumberBox x:Name="BilateralSigmaColor" Header="Color sigma" Value="75" Minimum="0.1" Maximum="1000" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="BilateralSigmaColor"/>
        <NumberBox x:Name="BilateralSigmaSpace" Header="Spatial sigma (px)" Value="75" Minimum="0.1" Maximum="1000" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="BilateralSigmaSpace"/>
        <ComboBox x:Name="BorderTypePicker" Header="Border type" SelectedIndex="0" SelectionChanged="FilterVariantChanged" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="BorderType">
          <ComboBoxItem Content="Constant" Tag="constant"/>
          <ComboBoxItem Content="Replicate" Tag="replicate"/>
          <ComboBoxItem Content="Reflect" Tag="reflect"/>
          <ComboBoxItem Content="Reflect 101 (Default)" Tag="reflect_101"/>
          <ComboBoxItem Content="Wrap" Tag="wrap"/>
        </ComboBox>
        <TextBlock x:Name="BorderTypeHint" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
        <NumberBox x:Name="BorderWidthInput" Header="Border width (px)" Value="2" Minimum="1" Maximum="32768" SpinButtonPlacementMode="Compact" />
        <NumberBox x:Name="LowThreshold" Header="Lower edge threshold" Value="100" Minimum="0" SpinButtonPlacementMode="Compact" />
        <NumberBox x:Name="HighThreshold" Header="Upper edge threshold" Value="200" Minimum="0" SpinButtonPlacementMode="Compact" />
        <ComboBox x:Name="ChannelPicker" Header="Channel / color" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="Red" Tag="red"/><ComboBoxItem Content="Green" Tag="green"/><ComboBoxItem Content="Blue" Tag="blue"/><ComboBoxItem Content="Alpha" Tag="alpha"/></ComboBox>
        <TextBlock x:Name="ColorHint" Text="Uses the RGBA color from the Color panel below." TextWrapping="Wrap" FontSize="12"/>
        <TextBlock x:Name="SourceHint" Text="Draw a target selection, then choose the source image and region below." TextWrapping="Wrap" FontSize="12"/>
        <TextBlock x:Name="PixelHint" Text="Click a pixel on the canvas or enter its coordinates." TextWrapping="Wrap" FontSize="12"/>
        <NumberBox x:Name="PixelX" Header="Pixel X" Value="0" Minimum="0" Maximum="32767" SpinButtonPlacementMode="Compact"/>
        <NumberBox x:Name="PixelY" Header="Pixel Y" Value="0" Minimum="0" Maximum="32767" SpinButtonPlacementMode="Compact"/>
        <NumberBox x:Name="PaletteSize" Header="Maximum colors" Value="16" Minimum="1" Maximum="256" SpinButtonPlacementMode="Compact"/>
      </StackPanel>
    </Expander>
    <Button x:Name="ApplyButton" Content="Apply" IsEnabled="False" Click="ApplyClicked" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="ApplyOperation" />
    <TextBlock Text="Image edits create a new version in your library." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
    <InfoBar x:Name="OperationStatus" IsOpen="False" IsClosable="True" Severity="Informational" />
  </StackPanel>
</UserControl>
