<UserControl x:Class="PhotoLab.UI.Views.ToolboxPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoLab.UI.Views">
  <UserControl.Resources>
    <CollectionViewSource x:Name="ToolsSource" IsSourceGrouped="True"/>
  </UserControl.Resources>
  <Pivot x:Name="CatalogTabs">
  <PivotItem Header="Tools" Margin="0"><ListView x:Name="ToolList" ItemsSource="{Binding Source={StaticResource ToolsSource}}"
      SelectionMode="Single" SelectionChanged="ToolChanged" HorizontalContentAlignment="Stretch"
      IsItemClickEnabled="True" ItemClick="ToolInvoked" AutomationProperties.AutomationId="Toolbox"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListView.ItemContainerStyle>
      <Style TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="4,1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
        <Setter Property="AutomationProperties.AutomationId" Value="{Binding Operation}"/>
      </Style>
    </ListView.ItemContainerStyle>
    <ListView.GroupStyle>
      <GroupStyle>
        <GroupStyle.HeaderContainerStyle>
          <Style TargetType="ListViewHeaderItem">
            <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
          </Style>
        </GroupStyle.HeaderContainerStyle>
        <GroupStyle.HeaderTemplate>
          <DataTemplate><TextBlock Text="{Binding Title}" Margin="14,12,0,6" Style="{StaticResource SectionLabelStyle}"/></DataTemplate>
        </GroupStyle.HeaderTemplate>
      </GroupStyle>
    </ListView.GroupStyle>
    <ListView.ItemTemplate>
      <DataTemplate>
        <Grid ColumnSpacing="12" ToolTipService.ToolTip="{Binding Description}" AutomationProperties.AutomationId="{Binding Operation}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <FontIcon Glyph="{Binding Glyph}" FontSize="16" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"/>
        </Grid>
      </DataTemplate>
    </ListView.ItemTemplate>
  </ListView></PivotItem>
  <PivotItem Header="Plugins" Margin="0"><views:PluginCatalog x:Name="Plugins"/></PivotItem>
  </Pivot>
</UserControl>
