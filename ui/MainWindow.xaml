<Window x:Class="PhotoLab.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:PhotoLab.UI.Controls.ImageCanvas"
    xmlns:queue="using:PhotoLab.UI.Controls.ImageQueueItem"
    xmlns:colors="using:PhotoLab.UI.Controls.ColorPicker"
    xmlns:views="using:PhotoLab.UI.Views" Title="Imagine Neo">
  <Grid x:Name="Root" RequestedTheme="Dark" Background="#191B1D" Loaded="RootLoaded" AllowDrop="True" DragEnter="RootDragOver" DragOver="RootDragOver" DragLeave="RootDragLeave" Drop="RootDrop">
    <VisualStateManager.VisualStateGroups><VisualStateGroup>
      <VisualState x:Name="CompactWorkspace">
        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
        <VisualState.Setters>
          <Setter Target="ToolColumn.Width" Value="182"/><Setter Target="InspectorColumn.Width" Value="284"/>
          <Setter Target="BrandSubtitle.Visibility" Value="Collapsed"/>
        </VisualState.Setters>
      </VisualState>
      <VisualState x:Name="WideWorkspace"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1240"/></VisualState.StateTriggers></VisualState>
    </VisualStateGroup></VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <Grid Background="{StaticResource PanelBrush}" Padding="18,0" ColumnSpacing="24">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
        <Image Source="ms-appx:///Assets/imagine-neo-logo.png" Width="46" Height="46" AutomationProperties.Name="Imagine Neo: a smiling stick figure, arms crossed, thinking of neo"/>
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="imagine neo" FontSize="20" FontWeight="SemiBold" CharacterSpacing="-30"/>
          <TextBlock x:Name="BrandSubtitle" Text="A little imagination. A new perspective." Foreground="{StaticResource MutedBrush}" FontSize="10"/>
        </StackPanel>
      </StackPanel>
      <MenuBar Grid.Column="1" VerticalAlignment="Center">
        <MenuBarItem Title="File">
          <MenuFlyoutItem Text="Import images…" Click="ImportClicked" KeyboardAcceleratorTextOverride="Ctrl+O"/>
          <MenuFlyoutItem Text="Remove image" Click="RemoveClicked"/>
          <MenuFlyoutSeparator/><MenuFlyoutItem x:Name="SaveMenu" Text="Save image as..." Click="SaveClicked" KeyboardAcceleratorTextOverride="Ctrl+S" IsEnabled="False"/>
        </MenuBarItem>
        <MenuBarItem Title="Edit">
          <MenuFlyoutItem x:Name="UndoMenu" Text="Undo" Click="UndoClicked" KeyboardAcceleratorTextOverride="Ctrl+Z" IsEnabled="False"/><MenuFlyoutItem x:Name="RedoMenu" Text="Redo" Click="RedoClicked" KeyboardAcceleratorTextOverride="Ctrl+Y / Ctrl+Shift+Z" IsEnabled="False"/>
          <MenuFlyoutSeparator/><MenuFlyoutItem Text="Deselect" Click="ClearSelectionClicked" KeyboardAcceleratorTextOverride="Ctrl+D"/>
        </MenuBarItem>
        <MenuBarItem Title="View">
          <MenuFlyoutItem Text="Fit to canvas" Click="FitClicked" KeyboardAcceleratorTextOverride="Ctrl+0"/>
          <MenuFlyoutItem Text="Actual size (100%)" Click="ActualSizeClicked" KeyboardAcceleratorTextOverride="Ctrl+1"/>
          <MenuFlyoutSeparator/><MenuFlyoutItem Text="Masks" Click="ShowLayersClicked"/><MenuFlyoutItem Text="History" Click="ShowHistoryClicked"/>
        </MenuBarItem>
      </MenuBar>
      <Button x:Name="ImportButton" Grid.Column="2" Click="ImportClicked" VerticalAlignment="Center" Padding="16,9" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="ImportImages">
        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8E5;" FontSize="14"/><TextBlock Text="Import images" FontSize="12" FontWeight="SemiBold"/></StackPanel>
        <Button.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control"/></Button.KeyboardAccelerators>
      </Button>
    </Grid>
    <Grid Grid.Row="1" Padding="18,0" ColumnSpacing="16" Background="#25272A" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
        <FontIcon x:Name="ActiveToolIcon" Glyph="&#xE790;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
        <TextBlock x:Name="ActiveToolLabel" Text="Grayscale" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="ContextHint" Grid.Column="1" Text="Choose an image to get started" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button x:Name="UndoButton" Click="UndoClicked" IsEnabled="False" ToolTipService.ToolTip="Undo (Ctrl+Z)" AutomationProperties.AutomationId="Undo">
          <FontIcon Glyph="&#xE7A7;" FontSize="14"/>
          <Button.KeyboardAccelerators><KeyboardAccelerator Key="Z" Modifiers="Control"/></Button.KeyboardAccelerators>
        </Button>
        <Button x:Name="RedoButton" Click="RedoClicked" IsEnabled="False" ToolTipService.ToolTip="Redo (Ctrl+Y / Ctrl+Shift+Z)" AutomationProperties.AutomationId="Redo">
          <FontIcon Glyph="&#xE7A6;" FontSize="14"/>
          <Button.KeyboardAccelerators><KeyboardAccelerator Key="Y" Modifiers="Control"/><KeyboardAccelerator Key="Z" Modifiers="Control,Shift"/></Button.KeyboardAccelerators>
        </Button>
        <Button x:Name="SaveButton" Content="Save as" Click="SaveClicked" IsEnabled="False" ToolTipService.ToolTip="Save image (Ctrl+S)" AutomationProperties.AutomationId="SaveImage">
          <Button.KeyboardAccelerators><KeyboardAccelerator Key="S" Modifiers="Control"/></Button.KeyboardAccelerators>
        </Button>
        <Button Content="Deselect" Click="ClearSelectionClicked" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Clear selection (Ctrl+D)">
          <Button.KeyboardAccelerators><KeyboardAccelerator Key="D" Modifiers="Control"/></Button.KeyboardAccelerators>
        </Button>
        <Border Width="1" Background="{StaticResource DividerBrush}" Margin="6,6"/>
        <Button Content="Fit" Click="FitClicked" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Fit to canvas (Ctrl+0)">
          <Button.KeyboardAccelerators><KeyboardAccelerator Key="Number0" Modifiers="Control"/></Button.KeyboardAccelerators>
        </Button>
        <Button Content="100%" Click="ActualSizeClicked" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Actual size (Ctrl+1)">
          <Button.KeyboardAccelerators><KeyboardAccelerator Key="Number1" Modifiers="Control"/></Button.KeyboardAccelerators>
        </Button>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="ToolColumn" Width="212"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="320"/></Grid.ColumnDefinitions>
      <Grid Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="14,18,14,4" Spacing="12">
          <TextBlock Text="TOOLBOX" Style="{StaticResource SectionLabelStyle}"/>
          <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ToggleButton x:Name="SelectButton" Click="SelectToolClicked" HorizontalAlignment="Stretch" Padding="8,9" ToolTipService.ToolTip="Draw, move or resize a rectangular selection" AutomationProperties.AutomationId="SelectTool">
              <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xEF20;" FontSize="14"/><TextBlock Text="Select" FontSize="11"/></StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="PanButton" Grid.Column="1" Click="PanToolClicked" HorizontalAlignment="Stretch" Padding="8,9" ToolTipService.ToolTip="Pan the canvas. Middle or right mouse button also pans." AutomationProperties.AutomationId="PanTool">
              <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE7C9;" FontSize="14"/><TextBlock Text="Hand" FontSize="11"/></StackPanel>
            </ToggleButton>
          </Grid>
          <ToggleButton x:Name="DrawButton" Click="DrawToolClicked" HorizontalAlignment="Stretch" Padding="10,9" AutomationProperties.AutomationId="DrawTool">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xED63;" FontSize="14"/><TextBlock Text="Draw &amp; shapes" FontSize="12"/></StackPanel>
          </ToggleButton>
        </StackPanel>
        <views:ToolboxPanel x:Name="Toolbox" Grid.Row="1"/>
      </Grid>
      <Grid Grid.Column="1" Background="#191B1D">
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="140"/></Grid.RowDefinitions>
        <Grid Padding="16,0" Background="#202225" ColumnSpacing="10" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xEB9F;" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock x:Name="DocumentTitle" Grid.Column="1" Text="Your workspace" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="2" Text="{Binding ZoomText}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
        </Grid>
        <Grid x:Name="CanvasDropZone" Grid.Row="1" Background="Transparent" AllowDrop="True" DragOver="RootDragOver" Drop="RootDrop">
          <canvas:ImageCanvas x:Name="EditorCanvas" AllowDrop="True" AutomationProperties.AutomationId="EditorCanvas"/>
          <ScrollViewer x:Name="EmptyWorkspace" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center" Margin="24">
            <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="360" Padding="0,16">
              <Image Source="ms-appx:///Assets/imagine-neo-logo.png" Width="124" Height="124" AutomationProperties.Name="Imagine Neo mascot"/>
              <TextBlock Text="Make room for imagination." FontSize="25" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
              <TextBlock Text="Drop your images here. A new perspective starts with a single image." TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
              <Button x:Name="EmptyImportButton" Content="Browse images" Click="ImportClicked" HorizontalAlignment="Center" Padding="24,10" AutomationProperties.AutomationId="EmptyImportImages"/>
              <TextBlock Text="PNG · JPG · TIFF · BMP · GIF" FontSize="10" CharacterSpacing="60" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
          </ScrollViewer>
          <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Background="#EE212825" CornerRadius="12" Margin="16" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
              <FontIcon Glyph="&#xE898;" FontSize="38" Foreground="{StaticResource AccentBrush}"/>
              <TextBlock Text="Drop to import" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/>
              <TextBlock Text="Add images to your library" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>
        <Grid x:Name="LibraryDropZone" Grid.Row="2" AllowDrop="True" DragOver="RootDragOver" Drop="RootDrop" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
          <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Padding="16,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="LIBRARY" Style="{StaticResource SectionLabelStyle}"/><TextBlock x:Name="LibraryCount" Text="0 images" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <Button x:Name="RemoveButton" Grid.Column="2" Content="Remove" Click="RemoveClicked" Background="Transparent" BorderThickness="0" Padding="8,2" FontSize="10" IsEnabled="False"/>
          </Grid>
          <TextBlock x:Name="EmptyLibrary" Grid.Row="1" Text="Your originals and edited versions live here." FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="16,0"/>
          <ListView x:Name="ImageList" Grid.Row="1" ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage, Mode=TwoWay}" SelectionChanged="ImageSelectionChanged"
              SelectionMode="Single" AllowDrop="True" DragOver="RootDragOver" Drop="RootDrop" CanDragItems="False" CanReorderItems="False" Margin="8,0,8,6"
              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" AutomationProperties.AutomationId="ImageQueue">
            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="2,0"/><Setter Property="CornerRadius" Value="6"/></Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate><DataTemplate><queue:ImageQueueItem/></DataTemplate></ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Grid>
      <Grid Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
        <Pivot x:Name="InspectorTabs" SelectionChanged="MaskInspectorChanged">
          <PivotItem Header="Properties" Margin="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Padding="18,8,18,20" Spacing="16">
                <views:ProcessingPanel x:Name="ProcessingTools" ApplyRequested="ApplyProcessingRequested"/>
                <StackPanel x:Name="DrawingPanel" Visibility="Collapsed" Spacing="12">
                  <TextBlock Text="Draw &amp; shapes" FontSize="21" FontWeight="SemiBold"/>
                  <TextBlock Text="Draw on the image, then apply when you are ready." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                  <ComboBox x:Name="DrawingToolPicker" Header="Tool" SelectedIndex="0" SelectionChanged="DrawingToolChanged" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="DrawingToolPicker">
                    <ComboBoxItem Content="Brush" Tag="Brush"/><ComboBoxItem Content="Eraser" Tag="Eraser"/>
                    <ComboBoxItem Content="Rectangle" Tag="Rectangle"/><ComboBoxItem Content="Circle" Tag="Circle"/>
                    <ComboBoxItem Content="Line" Tag="Line"/><ComboBoxItem Content="Arrow" Tag="Arrow"/>
                  </ComboBox>
                  <NumberBox x:Name="BrushSizeInput" Header="Size / outline width (image pixels)" Minimum="1" Maximum="256" Value="8" SpinButtonPlacementMode="Compact" ValueChanged="BrushSizeChanged" AutomationProperties.AutomationId="BrushSize"/>
                  <TextBlock Text="Shapes use an outline. The eraser removes only the pending drawing." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                  <TextBlock x:Name="DrawingStatus" Text="No pending drawing" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                  <Button x:Name="ApplyDrawingButton" Content="Apply drawing" Click="ApplyDrawingClicked" HorizontalAlignment="Stretch" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="ApplyDrawing"/>
                  <Button x:Name="ClearDrawingButton" Content="Clear drawing" Click="ClearDrawingClicked" HorizontalAlignment="Stretch" IsEnabled="False"/>
                </StackPanel>
                <Border Height="1" Background="{StaticResource DividerBrush}"/>
                <Expander x:Name="SelectionSection" Header="Selection" Style="{StaticResource InspectorSectionStyle}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="{Binding SelectionText}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock Text="Draw a rectangle on the canvas. Drag inside to move it, or use the eight handles to resize." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    <Button Content="Clear selection" Click="ClearSelectionClicked"/>
                  </StackPanel>
                </Expander>
                <Expander x:Name="ColorSection" Header="Working color" Visibility="Collapsed" IsExpanded="True" Style="{StaticResource InspectorSectionStyle}"><colors:ColorPickerPanel x:Name="WorkingColor"/></Expander>
                <Expander x:Name="AnalysisSection" Header="Analysis results" Visibility="Collapsed" IsExpanded="True" Style="{StaticResource InspectorSectionStyle}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="{Binding AnalysisText}" TextWrapping="Wrap" FontSize="12"/>
                    <ListView ItemsSource="{Binding Palette}" SelectionChanged="PaletteSelectionChanged" MaxHeight="250" HorizontalContentAlignment="Stretch">
                      <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Padding="0,4">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Border Width="28" Height="28" Background="{Binding Swatch}" BorderBrush="#777777" BorderThickness="1" CornerRadius="4"/>
                          <StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" FontSize="11"/><TextBlock Text="{Binding FrequencyText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                        </Grid>
                      </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                  </StackPanel>
                </Expander>
                <Expander x:Name="SourceSection" Header="Source region" Visibility="Collapsed" IsExpanded="True" Style="{StaticResource InspectorSectionStyle}">
                  <StackPanel Spacing="10">
                    <ComboBox x:Name="SourceList" Header="Replacement image" ItemsSource="{Binding Images}" DisplayMemberPath="FileName" SelectedItem="{Binding SourceImage, Mode=TwoWay}" SelectionChanged="SourceSelectionChanged" HorizontalAlignment="Stretch"/>
                    <canvas:ImageCanvas x:Name="SourceCanvas" Height="170"/>
                    <TextBlock Text="{Binding SourceText}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                  </StackPanel>
                </Expander>
                <Expander Header="Document" Style="{StaticResource InspectorSectionStyle}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="{Binding DimensionsText}" FontSize="12"/>
                    <TextBlock Text="Original preserved. Images and versions remain available during this session." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="Save as exports the current applied version as PNG or JPEG. Apply a pending drawing before saving." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </PivotItem>
          <PivotItem Header="Masks" Margin="0">
            <ScrollViewer x:Name="MasksPanel">
              <StackPanel Padding="16" Spacing="10">
                <TextBlock Text="OpenCV masks" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="White pixels are active; black pixels are excluded. Masks do not cover the image. Choose which ones to send in each plugin's properties." TextWrapping="Wrap" FontSize="12"/>
                <ListView x:Name="MaskList" DisplayMemberPath="Label" SelectionChanged="MaskSelectionChanged" MaxHeight="180" SelectionMode="Single" AutomationProperties.AutomationId="MaskList"/>
                <Image x:Name="MaskPreview" MaxHeight="140" Stretch="Uniform" AutomationProperties.Name="Saved mask preview"/>
                <Button Content="New mask" Click="MaskNewClicked" HorizontalAlignment="Stretch"/>
                <TextBox x:Name="MaskName" Header="Mask name" MaxLength="256"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button x:Name="MaskUpButton" Content="Up" Tag="up" Click="MaskMoveClicked"/>
                  <Button x:Name="MaskDownButton" Content="Down" Tag="down" Click="MaskMoveClicked"/>
                </StackPanel>
                <Button x:Name="MaskDuplicateButton" Content="Duplicate mask" Click="MaskDuplicateClicked" HorizontalAlignment="Stretch"/>
                <Button x:Name="MaskRemoveButton" Content="Remove mask" Click="MaskRemoveClicked" HorizontalAlignment="Stretch"/>
                <ComboBox x:Name="MaskSource" Header="Source image (library)" ItemsSource="{Binding Images}" DisplayMemberPath="FileName" SelectionChanged="MaskSourceChanged" HorizontalAlignment="Stretch"/>
                <TextBlock Text="The source must match the target dimensions. When editing, the saved source is used unless you choose another image." TextWrapping="Wrap" FontSize="11"/>
                <ComboBox x:Name="MaskOutsideSelection" Header="Outside selection" SelectedIndex="0"
                    SelectionChanged="MaskOutsideSelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MaskOutsideSelection">
                  <ComboBoxItem Content="Black (0)"/><ComboBoxItem Content="White (255)"/>
                </ComboBox>
                <TextBlock Text="Invert affects the selected region. This choice sets the mask value outside it." TextWrapping="Wrap" FontSize="11"/>
                <TextBlock x:Name="MaskRegionHint" TextWrapping="Wrap" FontSize="12" AutomationProperties.AutomationId="MaskRegionHint"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="Select region" Click="SelectToolClicked"/>
                  <Button Content="Clear selection" Click="ClearSelectionClicked"/>
                </StackPanel>
                <ComboBox x:Name="MaskMethod" Header="Creation mode" DisplayMemberPath="Name" SelectionChanged="MaskMethodChanged" HorizontalAlignment="Stretch"/>
                <StackPanel x:Name="MaskPaintPanel" Visibility="Collapsed" Spacing="8">
                  <ComboBox x:Name="MaskPaintTool" Header="Paint tool" SelectedIndex="0" SelectionChanged="MaskPaintSettingsChanged" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MaskPaintTool">
                    <ComboBoxItem Content="Brush"/><ComboBoxItem Content="Eraser"/><ComboBoxItem Content="Selection (Rect)"/>
                  </ComboBox>
                  <NumberBox x:Name="MaskPaintSize" Header="Brush size (pixels)" Minimum="1" Maximum="256" Value="12" SpinButtonPlacementMode="Compact" ValueChanged="MaskPaintSizeChanged" AutomationProperties.AutomationId="MaskPaintSize"/>
                  <ComboBox x:Name="MaskPaintPreviewColor" Header="Preview color" SelectedIndex="0" SelectionChanged="MaskPaintSettingsChanged" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MaskPaintPreviewColor">
                    <ComboBoxItem Content="White"/><ComboBoxItem Content="Black"/>
                  </ComboBox>
                  <TextBlock x:Name="MaskPaintStatus" Text="Paint on the canvas. Painted pixels become white in the mask." TextWrapping="Wrap" FontSize="11"/>
                  <Button x:Name="MaskPaintClear" Content="Clear mask painting" Click="MaskPaintClearClicked" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MaskPaintClear"/>
                </StackPanel>
                <views:ProcessingPanel x:Name="MaskTools" ApplyRequested="MaskApplyRequested"/>
              </StackPanel>
            </ScrollViewer>
          </PivotItem>
          <PivotItem Header="History" Margin="0">
            <ScrollViewer><StackPanel Padding="20" Spacing="16">
              <FontIcon Glyph="&#xE81C;" FontSize="32" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" Margin="0,16,0,4"/>
              <TextBlock Text="Creative history" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock x:Name="HistoryStatus" Text="Choose an image to get started." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
              <TextBlock Text="Revisit editing steps, undo changes and restore an earlier state." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <Border Height="1" Background="{StaticResource DividerBrush}"/>
              <Button x:Name="HistoryUndoButton" Content="Undo" Click="UndoClicked" IsEnabled="False" HorizontalAlignment="Stretch"/><Button x:Name="HistoryRedoButton" Content="Redo" Click="RedoClicked" IsEnabled="False" HorizontalAlignment="Stretch"/>
              <TextBlock Text="Undo and redo affect the selected image: pending strokes first, then applied versions. Each imported image has its own history. All versions remain in the library." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </StackPanel></ScrollViewer>
          </PivotItem>
        </Pivot>
      </Grid>
    </Grid>
    <Grid Grid.Row="3" Background="#25272A" Padding="14,0" ColumnSpacing="18" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Status}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" AutomationProperties.AutomationId="ImportStatus"/>
      <TextBlock Grid.Column="1" Text="{Binding DimensionsText}" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
      <TextBlock Grid.Column="2" Text="{Binding CoordinatesText}" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
      <TextBlock Grid.Column="3" Text="{Binding BackendStatus}" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
      <Button Grid.Column="4" Content="Reconnect" Click="ReconnectClicked" Padding="8,2" VerticalAlignment="Center" FontSize="10" Background="Transparent" BorderThickness="0"/>
    </Grid>
    <ProgressBar x:Name="BusyProgress" Grid.Row="1" VerticalAlignment="Bottom" Height="2" IsIndeterminate="True" Visibility="Collapsed" IsHitTestVisible="False"/>
  </Grid>
</Window>
