<Application x:Class="PhotoLab.UI.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
      <Color x:Key="SystemAccentColor">#ADCBBB</Color>
      <SolidColorBrush x:Key="PanelBrush" Color="#212326" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2D30" />
      <SolidColorBrush x:Key="DividerBrush" Color="#36383B" />
      <SolidColorBrush x:Key="MutedBrush" Color="#A6ABAF" />
      <SolidColorBrush x:Key="AccentBrush" Color="#ADCBBB" />
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#ADCBBB" />
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#C0D8CC" />
      <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#91B09F" />
      <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#17231C" />
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#ADCBBB" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#C0D8CC" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#91B09F" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#17231C" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#17231C" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#17231C" />
      <Style TargetType="Button"><Setter Property="CornerRadius" Value="5" /><Setter Property="FontSize" Value="12" /></Style>
      <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="100"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      </Style>
      <Style x:Key="InspectorSectionStyle" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      </Style>
      <Style TargetType="primitives:PivotHeaderItem">
        <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="12,12"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
