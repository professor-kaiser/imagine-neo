{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photolab.local/contracts/ipc-v1.schema.json",
  "title": "Imagine Neo IPC v1",
  "description": "UTF-8 JSON + LF, maximum 64 KiB. Image pixels only use packed straight-alpha BGRA8 Windows mappings. Arithmetic bounds, finite numeric values, matching extents and result contracts are additionally validated at runtime.",
  "$defs": {
    "blur_parameters": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "radius"
          ],
          "properties": {
            "blur_type": {
              "const": "gaussian"
            },
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blur_type",
            "kernel_size"
          ],
          "properties": {
            "blur_type": {
              "const": "average"
            },
            "kernel_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blur_type",
            "kernel_size"
          ],
          "properties": {
            "blur_type": {
              "const": "median"
            },
            "kernel_size": {
              "type": "integer",
              "minimum": 3,
              "maximum": 255,
              "not": {
                "multipleOf": 2
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blur_type",
            "diameter",
            "sigma_color",
            "sigma_space"
          ],
          "properties": {
            "blur_type": {
              "const": "bilateral"
            },
            "diameter": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "sigma_color": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            "sigma_space": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            }
          }
        }
      ]
    },
    "border_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thickness",
        "color"
      ],
      "properties": {
        "border_type": {
          "enum": [
            "constant",
            "replicate",
            "reflect",
            "reflect_101",
            "wrap"
          ],
          "default": "constant"
        },
        "thickness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "properties": {
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "a": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "pixel_buffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_name",
        "width",
        "height",
        "channels",
        "dtype",
        "pixel_format",
        "row_stride_bytes",
        "buffer_size_bytes"
      ],
      "properties": {
        "mapping_name": {
          "type": "string",
          "pattern": "^PhotoLab_Image_[A-Za-z0-9_-]{1,100}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "channels": {
          "const": 4
        },
        "dtype": {
          "const": "uint8"
        },
        "pixel_format": {
          "const": "BGRA8"
        },
        "row_stride_bytes": {
          "type": "integer",
          "minimum": 4
        },
        "buffer_size_bytes": {
          "type": "integer",
          "minimum": 4,
          "maximum": 536870912
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "request_id",
        "message_type",
